# Database
# SQLite (development)
DATABASE_URL="file:./db/custom.db"

# PostgreSQL (production)
# DATABASE_URL="postgresql://user:password@localhost:5432/bali_haven?schema=public"

# NextAuth.js (untuk autentikasi production)
# NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
# NEXTAUTH_URL="http://localhost:3000"

# Payment Gateway (production)
# MIDTRANS_SERVER_KEY="your-midtrans-server-key"
# MIDTRANS_CLIENT_KEY="your-midtrans-client-key"
# XENDIT_API_KEY="your-xendit-api-key"

# Email Service (production)
# RESEND_API_KEY="your-resend-api-key"
# EMAIL_FROM="Bali Haven <noreply@balihaven.com>"

# Image Storage (production)
# CLOUDINARY_URL="cloudinary://api-key:api-secret@cloud-name"
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_ANON_KEY="your-supabase-anon-key"
